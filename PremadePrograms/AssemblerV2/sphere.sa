//Wireframe Sphere

//Variables
VAR1 clkspd 1
VAR2 lngtIndex 0
VAR2 errorAccumulated 0

//Start
LDDI 999
SMT
WMT
SMT
CPY MM_CLKPRE clkspd
GDT3 gINI 0 0
GPU
GDT3 gSNF 0 0
GPU
WMT

//Wait for any button press
LDDI 0
SHM (waitLoop)
LDA IO_BUTTON
SFM
JPE *waitLoop

//Load matrices (in order of appearance in this file)
LDAI 0 (progStart)
LDDI 48
ATB
BTA (matLoadLoop)
RDA *loadMat+1
MULI 2
ADDI z2yMat_A
RDA *ldaLoadMat+0
LDA 0 (ldaLoadMat)
RDA *loadMat+3
GDT3 gLDC 0 0 (loadMat)
GPU
BTA
ADDI 1
ATB
JPE *xferToMatRAM
JMP *matLoadLoop
GDT7 gLMV 0 0 0 1 2 23 (xferToMatRAM)
GPU //Loaded straight into MatRAM so can be overwritten in VRAM

//Load data
LDAI 0 (startDataLoad)
LDDI 448
ATB
BTA (dataLoadLoop)
RDA *loadData+1
MULI 2
ADDI sphere0_0_X
RDA *ldaLoadData+0
LDA 0 (ldaLoadData)
RDA *loadData+3
GDT3 gLDC 0 0 (loadData)
GPU
BTA
ADDI 1
ATB
JPE *initialTransformation
JMP *dataLoadLoop

//Post-Load transformation (switching Y and Z coordinates of data)
GDT7 gMM4 0 0 0 2 2 111 (initialTransformation)
GPU

//Reset error
LDAI 0
RDA errorAccumulated

//Transformation every frame
GDT7 gMM4 0 8 0 2 2 111 (mainLoop)
GPU

//Transform to display coords (Orthographic projection)
GDT7 gMM4 0 16 512 2 2 111
GPU

//Draw latitudes
LDAI 1
LDDI 6 //Only draw central 5 latitudes
ATB
BTA (latDrawLoop)
MULI 64
ADDI 512
RDA *drawLat+1
ADDI 4
RDA *drawLat+5
GDT7 gDRL 512 0 516 4 4 14 (drawLat)
GPU
BTA
ADDI 1
ATB
JPE *lngtDrawStart
JMP *latDrawLoop

//Draw longitudes
LDAI 0 (lngtDrawStart)
LDDI 15
ATB
BTA (lngtDrawLoop)
MULI 4
ADDI 512
RDA *drawLngt+1
ADDI 64
RDA *drawLngt+5
GDT7 gDRL 512 0 576 64 64 5 (drawLngt)
GPU
BTA
ADDI 1
ATB
JPE *sendFrame
JMP *lngtDrawLoop

//Send frame
GDT3 gSNF 0 0 (sendFrame)
GPU

//Floating point error accumulation correction
LDA errorAccumulated
ADDI 1
RDA errorAccumulated
LDDI 180
WFT
JPE *startDataLoad
JMP *mainLoop

//Swap Y and Z coordinates (with earth-like tilt of 23.45 degrees)
VAR2 z2yMat_A 1.0   // A B C D
VAR2 z2yMat_B 0.0   // E F G H
VAR2 z2yMat_C 0.0   // I J K L
VAR2 z2yMat_D 0.0   // M N O P
VAR2 z2yMat_E 0.0
VAR2 z2yMat_F 0.3979486313
VAR2 z2yMat_G -0.9174076994
VAR2 z2yMat_H 0.0
VAR2 z2yMat_I 0.0
VAR2 z2yMat_J 0.9174076994
VAR2 z2yMat_K 0.3979486313
VAR2 z2yMat_L 0.0
VAR2 z2yMat_M 0.0
VAR2 z2yMat_N 0.0
VAR2 z2yMat_O 0.0
VAR2 z2yMat_P 1.0

//Incremental Transformation Matrix (anticlockwise Z rotation @ 20RPM)
VAR2 transMat_A 0.999390827
VAR2 transMat_B 0.0
VAR2 transMat_C 0.0348994967
VAR2 transMat_D 0.0
VAR2 transMat_E 0.0
VAR2 transMat_F 1.0
VAR2 transMat_G 0.0
VAR2 transMat_H 0.0
VAR2 transMat_I -0.0348994967
VAR2 transMat_J 0.0
VAR2 transMat_K 0.999390827
VAR2 transMat_L 0.0
VAR2 transMat_M 0.0
VAR2 transMat_N 0.0
VAR2 transMat_O 0.0
VAR2 transMat_P 1.0

//Projection Matrix
VAR2 projMat_A 25.0
VAR2 projMat_B 0.0
VAR2 projMat_C 0.0
VAR2 projMat_D 63.0
VAR2 projMat_E 0.0
VAR2 projMat_F 25.0
VAR2 projMat_G 0.0
VAR2 projMat_H 31.0
VAR2 projMat_I 0.0
VAR2 projMat_J 0.0
VAR2 projMat_K 0.0
VAR2 projMat_L 0.0
VAR2 projMat_M 0.0
VAR2 projMat_N 0.0
VAR2 projMat_O 0.0
VAR2 projMat_P 0.0

//Sphere data
VAR2 sphere0_0_X 0.000000
VAR2 sphere0_0_Y 0.000000
VAR2 sphere0_0_Z 1.000000
VAR2 sphere0_0_W 1.0
VAR2 sphere0_1_X 0.000000
